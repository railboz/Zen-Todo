{
  "manifest_version": 3,
  "name": "Zen Todo",
  "version": "3.1.10",
  "description": "Une to-do list simple et zen / A simple, zen to-do list.",
  "browser_specific_settings": {
    "gecko": {
      "id": "zen-todo@example.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "contextMenus",
    "identity"
  ],
  "host_permissions": [
    "https://*.extensions.allizom.org/*"
  ],
  "background": {
    "scripts": [
      "i18n.js",
      "util.js",
      "sync.js",
      "background.js"
    ]
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+T"
      },
      "description": "Zen Todo"
    },
    "_execute_sidebar_action": {
      "suggested_key": {
        "default": "Alt+Shift+Z"
      },
      "description": "Zen Todo (panneau latéral)"
    }
  },
  "sidebar_action": {
    "default_title": "Zen Todo",
    "default_panel": "popup.html",
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    },
    "open_at_install": false
  },
  "action": {
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    },
    "default_title": "Zen Todo",
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src https://www.googleapis.com https://oauth2.googleapis.com; object-src 'none'; frame-src 'none'; form-action 'none'; base-uri 'none'"
  }
}
